{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "bmad-method",
  "version": "6.13.0-next",
  "description": "Breakthrough Method of Agile AI-driven Development",
  "keywords": [
    "agile",
    "ai",
    "orchestrator",
    "development",
    "methodology",
    "agents",
    "bmad"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmad-code-org/BMAD-METHOD.git"
  },
  "license": "MIT",
  "author": "Brian (BMad) Madison",
  "scripts": {
    "docs:build": "node docs-site/scripts/build-docs.mjs",
    "docs:dev": "astro dev --root docs-site",
    "docs:fix-links": "node docs-site/scripts/fix-doc-links.js",
    "docs:preview": "astro preview --root docs-site",
    "docs:validate-links": "node docs-site/scripts/validate-doc-links.js",
    "docs:validate-sidebar": "node docs-site/scripts/validate-sidebar-order.js",
    "format:check": "prettier --check \"docs-site/{scripts,test}/**/*.{js,mjs}\"",
    "format:fix": "prettier --write \"docs-site/{scripts,test}/**/*.{js,mjs}\"",
    "lint": "eslint docs-site/scripts docs-site/test --max-warnings=0",
    "quality": "uv run --frozen tools/quality.py",
    "test": "npm run test:docs && npm run test:python",
    "test:docs": "node docs-site/test/test-site-url.mjs && node docs-site/test/test-rehype-plugins.mjs",
    "test:implementation-model": "node docs-site/test/test-validate-published-implementation-model.mjs",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 uv run --frozen pytest",
    "validate:refs": "uv run tools/validate_file_refs.py --strict",
    "validate:skills": "uv run tools/validate_skills.py --strict"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.40.0",
    "@eslint/js": "^9.33.0",
    "astro": "^6.4.6",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-unicorn": "^60.0.0",
    "prettier": "^3.7.4",
    "sharp": "^0.33.5",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
