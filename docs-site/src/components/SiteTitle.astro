<style>
  .site-title {
    align-items: center;
    gap: 0.65rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 27px;
    height: 27px;
    background: var(--sl-color-white);
    color: var(--sl-color-bg);
  }

  .tile svg {
    width: 22px;
    height: 22px;
  }

  .wordmark {
    overflow: hidden;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
</style>
